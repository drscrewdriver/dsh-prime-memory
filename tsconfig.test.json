{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/ruminate.test.ts",
    "tests/stores.test.ts",
    "tests/rooms-registry.test.ts",
    "tests/room-review.test.ts",
    "tests/room-merge.test.ts",
    "tests/room-admin-endpoint.test.ts",
    "tests/recall-usage.test.ts",
    "tests/hall-room.integration.test.ts",
    "tests/metadata-validators.test.ts"
  ],
  "exclude": ["src/smoke.ts", "dist", "dist-smoke", "node_modules"]
}
